---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = "Frijolito AI" } = Astro.props;
const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang="es" class="h-full bg-slate-950 text-slate-100">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;600;800&family=Plus+Jakarta+Sans:wght@400;600&display=swap" rel="stylesheet">
    <style>
      body {
        font-family: 'Plus Jakarta Sans', sans-serif;
      }
      h1, h2, h3, h4, h5, h6 {
        font-family: 'Outfit', sans-serif;
      }
    </style>
  </head>
  <body class="min-h-full flex flex-col relative overflow-x-hidden">
    
    <!-- Header de Navegación -->
    <header class="border-b border-white/10 bg-slate-900/60 backdrop-blur-md sticky top-0 z-50">
      <div class="max-w-4xl mx-auto px-6 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2 group">
          <div class="w-7 h-7 rounded bg-gradient-to-tr from-violet-600 to-fuchsia-600 flex items-center justify-center shadow-md">
            <span class="text-white font-bold text-xs">F</span>
          </div>
          <span class="font-extrabold tracking-wider text-sm text-white">
            FRIJOLITO<span class="text-violet-500">.AI</span>
          </span>
        </a>
        
        <nav class="flex items-center gap-4">
          <a
            href="/"
            class={`text-xs font-semibold px-3 py-1.5 rounded-lg transition-colors ${
              pathname === "/" ? "bg-white/10 text-white" : "text-gray-400 hover:text-white"
            }`}
          >
            Inicio
          </a>
          <a
            href="/about"
            class={`text-xs font-semibold px-3 py-1.5 rounded-lg transition-colors ${
              pathname === "/about" ? "bg-white/10 text-white" : "text-gray-400 hover:text-white"
            }`}
          >
            Acerca de
          </a>
        </nav>
      </div>
    </header>

    <!-- Contenido Principal -->
    <main class="flex-1 w-full max-w-4xl mx-auto">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-white/5 py-6 bg-slate-950 text-center text-xs text-gray-500">
      <p>© {new Date().getFullYear()} Frijolito.AI. Astro + Deno + Gemini.</p>
    </footer>
  </body>
</html>
